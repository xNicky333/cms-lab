{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{
					"color": "#ffffff",
					"name": "Tło",
					"slug": "base"
				},
				{
					"color": "#1a1a1a",
					"name": "Tekst",
					"slug": "contrast"
				},
				{
					"color": "#702082",
					"name": "Kolor marki",
					"slug": "primary"
				},
				{
					"color": "#007B8C",
					"name": "Akcent",
					"slug": "accent"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			]
		},
		"typography": {
			"fontSizes": [
				{
					"name": "Średni",
					"size": "1.125rem",
					"slug": "medium"
				},
				{
					"name": "Tytuł",
					"size": "clamp(2rem, 1.5rem + 2.5vw, 3.25rem)",
					"slug": "x-large"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "#ffffff"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			}
		}
	}
}